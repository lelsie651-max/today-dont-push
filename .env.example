# ==== apps/api ====
# API 监听端口与地址
PORT=3001
HOST=0.0.0.0

# ==== PostgreSQL ====
# 与 compose.yaml 中的默认配置保持一致
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/today_dont_push

# ==== Web（可选） ====
# 生产部署时可显式指定前端请求的 API 基地址。
# 开发环境默认通过 Vite proxy 把 /v1 转发到 http://localhost:3001。
# VITE_API_BASE_URL=https://api.example.com
